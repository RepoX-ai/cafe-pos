# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# menu item photos uploaded at runtime through the admin UI (src/server/services/menu-image-upload.ts)
/public/uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test-results/
/playwright-report/

/var/uploads/

# Database dumps and ad-hoc backups — never commit these.
# Plain SQL / custom-format dumps can contain password hashes, PII, and
# business data. Keep them encrypted outside the repo (see
# docs/security-incident-backup-in-git.md and docs/backup-restore.md).
/backups/
# Ad-hoc SQL dumps at repo root (drizzle/migrations/*.sql stay tracked)
/*.sql
*.dump
docker-compose.override.yml

# Performance test output
perf-results/
