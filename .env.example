# Copy this file to .env for local development (Docker) or .env.local for
# `next dev` outside Docker. Never commit the real .env file.

# --- Database ---------------------------------------------------------
# Password for the Compose Postgres service (interpolated into docker-compose.yml).
# This is the schema-owner credential used only by migrations
# (`docker compose run --rm migrate`); the app connects as APP_DB_ROLE.
# Local-only value below — never reuse in staging/production.
POSTGRES_PASSWORD=local-dev-only-postgres-not-for-prod
# Least-privilege runtime role (rows only: no DDL, no rewriting the stock
# ledger or audit log). Created/updated by the migrate step. Use a URL-safe
# value, e.g. `openssl rand -hex 24`. See docs/deployment.md.
APP_DB_ROLE=cafe_pos_app
APP_DB_PASSWORD=local-dev-only-app-role-password
# Local Docker Compose Postgres (loopback bind; see docker-compose.yml):
DATABASE_URL=postgres://postgres:local-dev-only-postgres-not-for-prod@localhost:5432/cafe_pos
# Managed Postgres (staging/production) — use the provider's connection
# string, e.g. Supabase/Neon/RDS. Include ?sslmode=require where needed.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Outside Compose, migrations can use separate owner credentials:
# MIGRATION_DATABASE_URL=postgres://owner:password@host:5432/dbname

# --- Auth ---------------------------------------------------------------
# Pepper for HMAC-SHA256 session-token hashes. Required. In production the
# app refuses to boot if this is missing, shorter than 32 chars, or a known
# placeholder. Generate with:
#   openssl rand -base64 32
# Rotating AUTH_SECRET invalidates every existing session (users re-login).
# The value below is local-dev only; replace before any shared/staging host.
AUTH_SECRET=local-dev-only-auth-secret-min-32-chars-xx

# --- App ------------------------------------------------------------------
APP_URL=http://localhost:3000
# One timezone for the whole install, fixed at BUILD time so the server and
# the browser agree (src/lib/dates). Changing it needs a rebuild. A runtime
# BUSINESS_TIMEZONE is optional; if set, it must equal this or startup fails.
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Jakarta
BUSINESS_TIMEZONE=Asia/Jakarta
# How many businesses (tenants) this install may hold. Each one is its own
# menu, stock, orders, audit trail and image folder. Default 3.
MAX_BUSINESSES=3
# Connection pools per app process (see docs/deployment.md § Database connections).
# App/checkout pool, and a separate small pool for dashboards, reports and CSV exports.
# DATABASE_POOL_MAX=5
# DATABASE_REPORT_POOL_MAX=2
# Per-connection timeouts (ms). Set DATABASE_SESSION_TIMEOUTS=off only for a
# pooler that rejects startup parameters (exports still apply their own).
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# DATABASE_REPORT_STATEMENT_TIMEOUT_MS=30000
# DATABASE_LOCK_TIMEOUT_MS=5000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# DATABASE_REPORT_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_SESSION_TIMEOUTS=on
# CSV exports: row cap, wall-clock cap, and exports running at once across all instances.
# EXPORT_MAX_ROWS=100000
# EXPORT_MAX_SECONDS=120
# EXPORT_MAX_CONCURRENT=2
# bcrypt (login / password resets): hashes at once per process, and how many may wait.
# BCRYPT_MAX_CONCURRENT=2
# BCRYPT_MAX_QUEUE=32

# --- Client IP / reverse proxy ------------------------------------------------
# Forwarding headers are client-controlled unless a proxy you run rewrites
# them, so none is trusted by default. Set at most one (see docs/deployment.md):
#   Vercel:                                        TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
#   Nginx "proxy_set_header X-Real-IP $remote_addr": TRUSTED_CLIENT_IP_HEADER=x-real-ip
#   Nginx "$proxy_add_x_forwarded_for" (one proxy): TRUSTED_PROXY_COUNT=1
# Neither set (local dev): no client IP; per-IP login limits are skipped.
# Production: exactly ONE of these is required, or the app refuses to start.
# A LAN-only install with no reverse proxy must say so with TRUSTED_CLIENT_IP_NONE=1.
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_PROXY_COUNT=
TRUSTED_CLIENT_IP_NONE=

# --- Rate limits (optional overrides, "<attempts>/<window seconds>") ----------
# Defaults: login per IP 50/900, per account+IP 10/900, per account 20/900,
# checkout per user 60/60, checkout retries per user 120/60 (never refused; past it
# the print step is skipped), print retry/reprint per user 20/60, CSV export per user 20/300,
# order cancel/refund per user 30/60, staff writes per user 20/300,
# purchases/stock counts/adjustments/waste per user 60/60, other admin writes per user 120/60,
# image uploads per user 20/300, report page loads per user 120/60,
# new businesses per user 5/3600, business switches per user 30/60.
# RATE_LIMIT_LOGIN_IP=50/900
# RATE_LIMIT_LOGIN_ACCOUNT_IP=10/900
# RATE_LIMIT_LOGIN_ACCOUNT=20/900
# RATE_LIMIT_CHECKOUT=60/60
# RATE_LIMIT_PRINT=20/60
# RATE_LIMIT_EXPORT=20/300
# RATE_LIMIT_ORDER_MUTATION=30/60
# RATE_LIMIT_STAFF_WRITE=20/300
# RATE_LIMIT_CHECKOUT_RETRY=120/60
# RATE_LIMIT_INVENTORY_WRITE=60/60
# RATE_LIMIT_CATALOG_WRITE=120/60
# RATE_LIMIT_UPLOAD=20/300
# RATE_LIMIT_REPORT_READ=120/60
# RATE_LIMIT_CREATE_BUSINESS=5/3600
# RATE_LIMIT_SWITCH_BUSINESS=30/60

# Deliberately no NODE_ENV here: `next dev`/`next build`/`next start` each
# manage it themselves, and setting it in .env risks a stale/wrong value
# leaking into request-time checks (e.g. secure cookies, the dev-only
# account switcher) if someone forgets to update it for a given command.

# --- File storage (only required if image/attachment uploads are enabled) -
# Must be S3-compatible (AWS S3, Cloudflare R2, MinIO, Supabase Storage, ...).
# Leave unset to disable uploads; the app must not depend on ephemeral local
# disk for business assets.
STORAGE_PROVIDER=
# local: PC/VPS durable disk only; s3: required for Vercel uploads
MENU_IMAGE_DIR=
STORAGE_PUBLIC_URL=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Printing -------------------------------------------------------------
# device     -> Bluetooth printer paired with the staff tablet (production:
#               the tablet prints over Web Bluetooth and reports the result)
# browser    -> browser print fallback (no Bluetooth printer)
# mock       -> in-memory/test provider, always "succeeds" — staging only
# bridge     -> NOT SUPPORTED: placeholder with no protocol; production refuses it
# Production requires this to be set; an unknown value stops startup instead of
# silently falling back to mock.
PRINT_PROVIDER=mock
# Set to 1 to allow /pos?printer=sim in a production build (a fake
# printer for testing without hardware). Never set it on the real till.
NEXT_PUBLIC_ALLOW_PRINTER_SIM=
# Reserved for the unimplemented bridge adapter; not read by anything today.
PRINT_BRIDGE_URL=
PRINT_BRIDGE_SECRET=
# A print claim expires after this many seconds (keep it above the slowest
# printer call); an abandoned claim then shows as "outcome unknown".
# PRINT_JOB_LEASE_SECONDS=120
# Attempts per print job before only a deliberate Reprint can resend it.
# PRINT_JOB_MAX_ATTEMPTS=5

# --- Observability ------------------------------------------------------------
# Logs are JSON lines on stdout/stderr (collect them with `docker compose logs`
# or any log shipper). There is no Sentry integration: a SENTRY_DSN is ignored
# and logged as such. Thresholds for db.slow_query / db.slow_transaction /
# db.pool_wait events (ms), and LOG_LEVEL=debug for more detail:
# SLOW_QUERY_MS=500
# SLOW_TRANSACTION_MS=1000
# POOL_WAIT_WARN_MS=200
# LOG_LEVEL=info
